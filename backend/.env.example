# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Database (local PostgreSQL example)
# DATABASE_URL is used on Railway; local settings.py may use NAME/USER/PASSWORD instead.

# Omniport OAuth
OMNIPORT_BASE_URL=https://channeli.in
OMNIPORT_CLIENT_ID=
OMNIPORT_CLIENT_SECRET=
OMNIPORT_REDIRECT_URI=http://127.0.0.1:8000/api/auth/omniport/callback/

# Email (Gmail app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Cloud storage (S3-compatible) ---
# Set USE_S3=true to store uploads in the cloud instead of backend/media/
# Works with: Cloudflare R2, AWS S3 free tier, Supabase Storage, Backblaze B2
USE_S3=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto

# Required for Cloudflare R2 / Supabase (leave empty for AWS S3)
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

AWS_S3_FILE_OVERWRITE=false
